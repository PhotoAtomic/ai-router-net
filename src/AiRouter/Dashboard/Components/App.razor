@namespace AiRouter.Dashboard.Components
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AiRouter Dashboard</title>
    <base href="/" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; font-family: 'Segoe UI', system-ui, sans-serif; background: #0f1117; color: #e2e8f0; }
        a { color: #63b3ed; text-decoration: none; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <Routes @rendermode="@Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer" />
    <script src="_framework/blazor.server.js"></script>
</body>
</html>

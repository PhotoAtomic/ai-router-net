{
  "RoutingRules": [
    {
      "Pattern": "(sonnet)",
      "BaseUrl": "http://localhost:8081",
      "ForceModel": "Qwen3.6-27B-MTP-Q8_0.gguf",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \"C:\\Program Files\\Llama.cpp\" -File \"C:\\Program Files\\Llama.cpp\\llama-vulkan-mtp.ps1\"",
        "StartupDelaySeconds": 20
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true,
      "EndpointType": "Anthropic"
    },
    {
      "Pattern": "(opus)",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": "qwen36-dense",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \"C:\\Program Files\\Llama.cpp\" -File \"C:\\Program Files\\Llama.cpp\\llama.ps1\"",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true,
      "EndpointType": "Anthropic"
    },
    {
      "Pattern": "(haiku)",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": "granite",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \"C:\\Program Files\\Llama.cpp\" -File \"C:\\Program Files\\Llama.cpp\\llama.ps1\"",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true,
      "EndpointType": "Anthropic"
    }
  ],
  "ApiKeys": {
    "api.OpenAI.com": "${OpenAI_API_KEY}"
  },
  "DefaultApiKey": "local",
  "Host": "http://127.0.0.1",
  "Port": "5000"
}
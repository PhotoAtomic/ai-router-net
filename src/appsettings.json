{
  "RoutingRules": [
    {
      "Pattern": "(claude)|(sonnet)|(opus)|(haiku)",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": "deepseek-flash",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \u0022C:\\Program Files\\Llama.cpp\u0022 -File \u0022C:\\Program Files\\Llama.cpp\\llama.ps1\u0022",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true
    },
    {
      "Pattern": ".*",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": null,
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \u0022C:\\Program Files\\Llama.cpp\u0022 -File \u0022C:\\Program Files\\Llama.cpp\\llama.ps1\u0022",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true
    }
  ],
  "ApiKeys": {
    "api.anthropic.com": "${ANTHROPIC_API_KEY}"
  },
  "DefaultApiKey": "local",
  "Host": "http://127.0.0.1",
  "Port": "5001"
}
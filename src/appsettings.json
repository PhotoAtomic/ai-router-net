{
  "RoutingRules": [
    {
      "Pattern": "(opus)",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": "granite",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \u0022C:\\Program Files\\Llama.cpp\u0022 -File \u0022C:\\Program Files\\Llama.cpp\\llama.ps1\u0022",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true,
      "EndpointType": "OpenAI"
    },
    {
      "Pattern": "(haiku)",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": "granite",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \u0022C:\\Program Files\\Llama.cpp\u0022 -File \u0022C:\\Program Files\\Llama.cpp\\llama.ps1\u0022",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true,
      "EndpointType": "OpenAI"
    },
    {
      "Pattern": ".*",
      "BaseUrl": "http://localhost:8080",
      "ForceModel": "nemotron",
      "Process": {
        "FileName": "pwsh",
        "Arguments": "-NoProfile -NonInteractive -WorkingDirectory \u0022C:\\Program Files\\Llama.cpp\u0022 -File \u0022C:\\Program Files\\Llama.cpp\\llama.ps1\u0022",
        "StartupDelaySeconds": 3
      },
      "EnableLLamaCppModelRecover": true,
      "IsLLamaCpp": true,
      "EndpointType": "OpenAI"
    }
  ],
  "ApiKeys": {
    "api.OpenAI.com": "${OpenAI_API_KEY}"
  },
  "DefaultApiKey": "local",
  "Host": "http://127.0.0.1",
  "Port": "5000"
}
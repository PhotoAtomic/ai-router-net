@namespace AiRouter.Dashboard.Components.Pages
@page "/dashboard/detail/{Id}"
@implements IDisposable
@inject LogWatcherService Watcher

@{
    LogEntryViewModel? vm = null;
    if (Guid.TryParse(Id, out var cid))
    {
        vm = Watcher.Entries.FirstOrDefault(e => e.CorrelationId == cid);
    }
}

@if (vm is null)
{
    <p>Entry not found. <a href="/dashboard">← Back</a></p>
}
else
{
    <div style="max-width:900px; margin:0 auto;">
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
            <a href="/dashboard" style="color:#63b3ed;">← Back to dashboard</a>
            <h2 style="margin:0; font-size:1.2rem; color:#90cdf4;">Request detail</h2>
            @if (!vm.HasResponse)
            {
                <span style="color:#ecc94b; font-size:.85rem;">⏳ waiting for response…</span>
            }
        </div>

        <!-- ── Overview card ─────────────────────────────────── -->
        <div style="@Card">
            <h3 style="@CardTitle">Overview</h3>
            <div style="@Grid">
                <Prop Label="Correlation ID" Value="@vm.CorrelationId.ToString()" Mono="true" />
                <Prop Label="Request time"   Value="@vm.RequestTimestamp.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff")" />
                <Prop Label="Response time"  Value="@(vm.HasResponse ? vm.ResponseTimestamp!.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff") : "—")" />
                <Prop Label="Duration"       Value="@(vm.HasResponse ? $"{vm.DurationMs:F2} ms" : "—")" />
                <Prop Label="HTTP status"    Value="@(vm.HasResponse ? vm.StatusCode.ToString() : "—")" />
                <Prop Label="Model requested"Value="@vm.Model" Mono="true" />
                <Prop Label="Forced model"   Value="@vm.ForcedModel" Mono="true" />
                <Prop Label="Matched rule"   Value="@vm.MatchedRule" Mono="true" />
                <Prop Label="Target endpoint"Value="@vm.TargetUrl" Mono="true" />
                <Prop Label="Request size"   Value="@FormatBytes(vm.RequestBytes)" />
                <Prop Label="Response size"  Value="@(vm.HasResponse ? FormatBytes(vm.ResponseBytes) : "—")" />
            </div>
        </div>

        <!-- ── Request headers ───────────────────────────────── -->
        <div style="@Card">
            <h3 style="@CardTitle">Request headers</h3>
            <table style="@TableStyle">
                @foreach (var kv in vm.RequestHeaders ?? Enumerable.Empty<KeyValuePair<string, string>>())
                {
                    <tr><td style="@KeyTd">@kv.Key</td><td style="@ValTd">@kv.Value</td></tr>
                }
            </table>
        </div>

        <!-- ── Response headers ──────────────────────────────── -->
        <div style="@Card">
            <h3 style="@CardTitle">Response headers</h3>
            @if (vm.HasResponse)
            {
                <table style="@TableStyle">
                    @foreach (var kv in vm.ResponseHeaders ?? Enumerable.Empty<KeyValuePair<string, string>>())
                    {
                        <tr><td style="@KeyTd">@kv.Key</td><td style="@ValTd">@kv.Value</td></tr>
                    }
                </table>
            }
            else
            {
                <p style="color:#718096; margin:0;">— waiting for response —</p>
            }
        </div>

        <!-- ── Anthropic request detail ──────────────────────── -->
        @{
            var anthropic = AnthropicRequestParser.TryParse(vm.RequestBody);
        }
        @if (anthropic is not null)
        {
            <div style="@Card">
                <h3 style="@CardTitle">Request (parsed)</h3>

                @if (anthropic.System is { Count: > 0 })
                {
                    <div style="margin-bottom:.75rem;">
                        <div style="font-size:.75rem; color:#718096; margin-bottom:.25rem;">system</div>
                        @foreach (var sb in anthropic.System)
                        {
                            <pre style="@PreStyle; margin-bottom:.35rem;">@DecodeText(sb.Text ?? string.Empty)</pre>
                        }
                    </div>
                }

                @if (anthropic.Tools is { Count: > 0 })
                {
                    <div style="margin-bottom:.75rem;">
                        <div style="font-size:.75rem; color:#718096; margin-bottom:.25rem;">tools (@anthropic.Tools.Count)</div>
                        @foreach (var tool in anthropic.Tools)
                        {
                            <div style="font-size:.8rem; padding:.25rem 0; border-bottom:1px solid #2d3748;">
                                <span style="font-family:monospace; color:#90cdf4;">@tool.Name</span>
                                @if (!string.IsNullOrEmpty(tool.Description))
                                {
                                    <span style="color:#a0aec0;"> — @tool.Description</span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (anthropic.Messages is { Count: > 0 })
                {
                    <div style="font-size:.75rem; color:#718096; margin-bottom:.4rem;">messages (@anthropic.Messages.Count)</div>
                    @foreach (var msg in anthropic.Messages)
                    {
                        var roleColor = msg.Role == "assistant" ? "#90cdf4" : "#68d391";
                        <div style="margin-bottom:.5rem; border-left:3px solid @roleColor; padding-left:.6rem;">
                            <div style="font-size:.75rem; color:@roleColor; margin-bottom:.2rem;">@msg.Role</div>
                            <pre style="@PreStyle; margin:0;">@DecodeText(AnthropicRequestParser.GetMessageText(msg))</pre>
                        </div>
                    }
                }
            </div>
        }

        <!-- ── Request body ──────────────────────────────────── -->
        <div style="@Card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem;">
                <h3 style="margin:0; font-size:1rem; color:#90cdf4;">Request body</h3>
                <span style="font-size:.75rem; color:#718096;">@FormatBytes(vm.RequestBytes)</span>
            </div>
            <pre style="@PreStyle">@PrettyJson(vm.RequestBody)</pre>
        </div>

        <!-- ── Response body ─────────────────────────────────── -->
        <div style="@Card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem;">
                <h3 style="margin:0; font-size:1rem; color:#90cdf4;">Response body</h3>
                <span style="font-size:.75rem; color:#718096;">@(vm.HasResponse ? FormatBytes(vm.ResponseBytes) : "—")</span>
            </div>
            @if (vm.HasResponse)
            {
                <pre style="@PreStyle">@PrettyJson(vm.ResponseBody)</pre>
            }
            else
            {
                <p style="color:#718096; margin:0;">— waiting for response —</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    protected override void OnInitialized()
        => Watcher.Changed += OnChanged;

    void OnChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Watcher.Changed -= OnChanged;

    static string FormatBytes(long bytes) => bytes switch
    {
        < 1024        => $"{bytes} B",
        < 1024 * 1024 => $"{bytes/1024.0:F1} KB",
        _             => $"{bytes/1024.0/1024:F2} MB",
    };

    // JsonSerializer.Deserialize already unescapes \uXXXX when parsing the JSON body,
    // so strings from AnthropicRequestParser are already decoded — just return as-is.
    static string DecodeText(string s) => s;

    static string PrettyJson(string raw)    {
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(raw);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return raw; }
    }

    // ── inline styles ────────────────────────────────────────

    const string Card      = "background:#1a202c; border:1px solid #2d3748; border-radius:8px; padding:1.25rem; margin-bottom:1rem;";
    const string CardTitle = "margin:0 0 .75rem; font-size:1rem; color:#90cdf4;";
    const string Grid      = "display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:.5rem;";
    const string TableStyle= "width:100%; border-collapse:collapse; font-size:.8rem;";
    const string KeyTd     = "padding:.3rem .5rem; color:#a0aec0; white-space:nowrap; font-size:.8rem; width:200px;";
    const string ValTd     = "padding:.3rem .5rem; font-family:monospace; font-size:.8rem; word-break:break-all;";
    const string PreStyle  = "background:#171923; border:1px solid #2d3748; border-radius:6px; padding:1rem; overflow:auto; max-height:500px; font-size:.75rem; line-height:1.5; color:#e2e8f0; white-space:pre-wrap; word-break:break-all; margin:0;";
}

{
  "RoutingRules": [
    {
      "Pattern": "(claude)|(sonnet)|(opus)|(haiku)",
      "BaseUrl": "https://api.anthropic.com"
    },
    {
      "Pattern": ".*",
      "BaseUrl": "http://localhost:8080"
    }
  ],
  "ApiKeys": {
    "api.anthropic.com": "${ANTHROPIC_API_KEY}"
  },
  "DefaultApiKey": "local",
  "Host": "http://0.0.0.0",
  "Port": "5000"
}

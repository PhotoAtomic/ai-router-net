<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Trimming disabled: Blazor Server relies heavily on reflection -->
    <PublishTrimmed>false</PublishTrimmed>
    <TrimmerRootDescriptor>AiRouter\TrimmerRoots.xml</TrimmerRootDescriptor>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);IL2026;IL2104</NoWarn>

  </PropertyGroup>

  <ItemGroup>
    <!-- Keep entire System.Management and System.CodeDom assemblies:
         they are not trim-annotated and use reflection internally.
         We only use Win32_Process querying; ManagementClassGenerator is never invoked. -->
    <TrimmerRootAssembly Include="System.Management" />
    <TrimmerRootAssembly Include="System.CodeDom" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.6" />
  </ItemGroup>

</Project>
